# Rust
target/
# Cargo.lock is committed for reproducible builds of this binary crate + lib.
**/*.rs.bk
*.pdb

# Node/Bun
node_modules/
bun.lockb
.yarn/
.pnp.*

# Environment & Secrets
.env
.env.local
.env.*.local

# OpenTofu / Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
# tfvars files contain sensitive credentials — keep out of version control.
# Commit terraform.tfvars.example instead of terraform.tfvars.
*.tfvars
*.tfvars.json
# Override files are local-only
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Plan output
*tfplan*
# CLI config
.terraformrc
terraform.rc

# Build outputs
/static/main.js
/static/main.js.map
/static/app.css
/static/app.js
/static/app.js.map
/static/styles.css
/static/*.wasm
/static/*.data

# IDE & Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
Thumbs.db

.fastembed_cache/

config.yaml
!openspec/config.yaml

# Testing artifacts
tests/coverage/
test-results/
playwright-report/
coverage/
coverage_report/
*.prof*
*.gcda
*.gcno
test-config.yaml
.nyc_output/

# Generated files
src-tauri/gen/
*.tsbuildinfo
/data/
static/assets

# Git worktrees must live under ~/.claude/worktrees/ — defense-in-depth so
# stray in-repo worktrees never enter the index. See scripts/worktree-new.sh
# and the "Worktree convention" section in CLAUDE.md / AGENTS.md.
/.claude/worktrees/

# Local agent/editor/research tooling state — machine-local, not shared.
.agents/
.firecrawl/
.zed/

# Local pk/Karpathy LLM-wiki state (events log + generated wiki articles) —
# machine-local knowledge cache, not shared project content.
.prometheus/
