{
  "name": "@prometheus-ags/universal-agent-runtime-sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for universal-agent-runtime - HTTP client for the agentic AI application",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "test": "vitest run",
    "lint": "eslint src test examples",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.examples.json --noEmit",
    "docs": "typedoc",
    "examples": "tsc -p tsconfig.examples.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Prometheus-AGS/universal-agent-runtime.git",
    "directory": "sdks/typescript"
  },
  "keywords": ["sdk", "api", "client", "llm", "agent", "rag"],
  "author": "Developer",
  "license": "MIT",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "dependencies": {
    "@microsoft/fetch-event-source": "^2.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
