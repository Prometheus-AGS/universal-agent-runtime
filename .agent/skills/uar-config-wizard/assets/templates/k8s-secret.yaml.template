# Kubernetes Manifests for UAR Deployment
# Generated by /uar-config-wizard (/uar-k8s-config or /uar-stack --with-k8s)
# Split: sensitive fields → Secret, non-sensitive → ConfigMap
#
# Apply: kubectl apply -f k8s/

---
# ===========================================================================
# UAR Secret — sensitive configuration
# Contains: jwt_secret, database_url, redis_url, API keys
# ===========================================================================
apiVersion: v1
kind: Secret
metadata:
  name: uar-secrets
  namespace: {{k8s_namespace}}
  labels:
    app: uar
    component: config
type: Opaque
stringData:
  # JWT signing secret. Generate: openssl rand -base64 64
  jwt_secret: "<REPLACE: $(openssl rand -base64 64)>"

  # Database connection string
  database_url: "<REPLACE: {{db_connection_pattern}}>"

{{#if redis_enabled}}
  # Redis connection string
  redis_url: "<REPLACE: redis://redis-service:6379>"
{{/if}}

{{#if uses_openai}}
  # OpenAI API key
  openai_api_key: "<REPLACE: sk-...>"
{{/if}}
{{#if uses_anthropic}}
  # Anthropic API key
  anthropic_api_key: "<REPLACE: sk-ant-...>"
{{/if}}
{{#if uses_groq}}
  # Groq API key
  groq_api_key: "<REPLACE: gsk_...>"
{{/if}}
{{#if uses_mistral}}
  # Mistral API key
  mistral_api_key: "<REPLACE: ...>"
{{/if}}

---
# ===========================================================================
# UAR ConfigMap — non-sensitive configuration
# ===========================================================================
apiVersion: v1
kind: ConfigMap
metadata:
  name: uar-config
  namespace: {{k8s_namespace}}
  labels:
    app: uar
    component: config
data:
  UAR_SERVER__PORT: "{{uar_port}}"
  UAR_SERVER__HOST: "0.0.0.0"
  UAR_SECURITY__JWT_REQUIRED: "{{jwt_required}}"
  UAR_PERSISTENCE__PROVIDER: "{{db_provider}}"
  UAR_PERSISTENCE__EXTERNAL_CACHE_ENABLED: "{{external_cache_enabled}}"
  UAR_LLM__MODEL: "{{llm_model}}"
  UAR_LLM__PROTOCOL: "{{llm_protocol}}"
{{#if llm_base_url}}
  UAR_LLM__BASE_URL: "{{llm_base_url}}"
{{/if}}
  UAR_LLM__TIMEOUT_SECS: "{{llm_timeout_secs}}"
  UAR_RESILIENCE__RATE_LIMIT_ENABLED: "{{rate_limit_enabled}}"
  UAR_RESILIENCE__REQUESTS_PER_SECOND: "{{requests_per_second}}"
  UAR_RESILIENCE__BURST_SIZE: "{{burst_size}}"

---
# ===========================================================================
# UAR Deployment
# ===========================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: uar
  namespace: {{k8s_namespace}}
  labels:
    app: uar
spec:
  replicas: {{k8s_replicas}}
  selector:
    matchLabels:
      app: uar
  template:
    metadata:
      labels:
        app: uar
    spec:
      containers:
        - name: uar
          image: {{k8s_image}}
          ports:
            - containerPort: {{uar_port}}
          envFrom:
            - configMapRef:
                name: uar-config
          env:
            - name: UAR_SECURITY__JWT_SECRET
              valueFrom:
                secretKeyRef:
                  name: uar-secrets
                  key: jwt_secret
            - name: UAR_PERSISTENCE__DATABASE_URL
              valueFrom:
                secretKeyRef:
                  name: uar-secrets
                  key: database_url
{{#if uses_openai}}
            - name: OPENAI_API_KEY
              valueFrom:
                secretKeyRef:
                  name: uar-secrets
                  key: openai_api_key
{{/if}}
{{#if uses_anthropic}}
            - name: ANTHROPIC_API_KEY
              valueFrom:
                secretKeyRef:
                  name: uar-secrets
                  key: anthropic_api_key
{{/if}}
{{#if redis_enabled}}
            - name: UAR_PERSISTENCE__REDIS_URL
              valueFrom:
                secretKeyRef:
                  name: uar-secrets
                  key: redis_url
{{/if}}
          resources:
            requests:
              memory: "256Mi"
              cpu: "250m"
            limits:
              memory: "1Gi"
              cpu: "1000m"
          livenessProbe:
            httpGet:
              path: /health
              port: {{uar_port}}
            initialDelaySeconds: 10
            periodSeconds: 30
          readinessProbe:
            httpGet:
              path: /health
              port: {{uar_port}}
            initialDelaySeconds: 5
            periodSeconds: 10

---
# ===========================================================================
# UAR Service
# ===========================================================================
apiVersion: v1
kind: Service
metadata:
  name: uar-service
  namespace: {{k8s_namespace}}
spec:
  selector:
    app: uar
  ports:
    - protocol: TCP
      port: 80
      targetPort: {{uar_port}}
  type: ClusterIP

{{#if candle_vllm_k8s}}
---
# ===========================================================================
# candle-vllm Deployment (local inference)
# Requires GPU node with nvidia.com/gpu resource
# ===========================================================================
apiVersion: apps/v1
kind: Deployment
metadata:
  name: candle-vllm
  namespace: {{k8s_namespace}}
  labels:
    app: candle-vllm
spec:
  replicas: 1
  selector:
    matchLabels:
      app: candle-vllm
  template:
    metadata:
      labels:
        app: candle-vllm
    spec:
      nodeSelector:
        nvidia.com/gpu: "true"
      containers:
        - name: candle-vllm
          image: prometheusags/candle-vllm:latest
          ports:
            - containerPort: 3000
          args:
            - "--model-alias"
            - "{{selected_model_name}}"
            - "--models-config"
            - "/config/models.yaml"
            - "--port"
            - "3000"
          volumeMounts:
            - name: models-config
              mountPath: /config
            - name: model-cache
              mountPath: /root/.cache/huggingface
          resources:
            limits:
              nvidia.com/gpu: "{{gpu_count}}"
              memory: "{{gpu_memory_gb}}Gi"
      volumes:
        - name: models-config
          configMap:
            name: candle-vllm-models-config
        - name: model-cache
          persistentVolumeClaim:
            claimName: model-cache-pvc

---
apiVersion: v1
kind: Service
metadata:
  name: candle-vllm-service
  namespace: {{k8s_namespace}}
spec:
  selector:
    app: candle-vllm
  ports:
    - protocol: TCP
      port: 3000
      targetPort: 3000
  type: ClusterIP
{{/if}}
