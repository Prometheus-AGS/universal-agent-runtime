# candle-vllm Model Configuration
# Generated by /uar-config-wizard (/uar-model-select or /uar-stack)
# Full reference: .agent/skills/uar-config-wizard/references/candle-vllm-catalog.md
# TurboQuant guide: .agent/skills/uar-config-wizard/references/turboquant-guide.md
#
# Place this file at the candle-vllm working directory or pass via:
#   candle-vllm --models-config /path/to/candle-vllm-models.yaml

# Default model alias used when no specific model is requested.
default_model: {{model_name}}

models:
  - name: {{model_name}}
    # HuggingFace model ID. Downloaded automatically on first run.
    hf_id: {{hf_id}}

{{#if weight_file}}
    # Pre-quantized GGUF weight file (downloaded from HuggingFace).
    # Only specify for GGUF models; omit for full-precision bf16/f16.
    weight_file: {{weight_file}}
{{/if}}

    params:
      # Data type for model weights.
      # bf16: NVIDIA Ampere+ (sm80+) and Apple M3/M4+
      # f16:  Older NVIDIA GPUs and Apple M1/M2
      # f32:  CPU-only inference
      dtype: {{dtype}}

      # KV-cache memory budget in MB.
      # Formula: available_vram_mb - model_weights_mb - os_headroom_mb
      # See: references/turboquant-guide.md for VRAM math
      mem: {{mem_mb}}

      # Max concurrent sequences in flight.
      # Tune based on VRAM headroom and request concurrency needs.
      max_num_seqs: {{max_num_seqs}}

      # Paged attention block size (tokens per block).
      # 16 is standard; 64 for GGUF models.
      block_size: {{block_size}}

      # GPU device IDs. For multi-GPU: [0, 1, 2, 3]
      device_ids: [{{device_ids}}]

      # Sampling defaults (can be overridden per-request).
      temperature: 0.7
      top_p: 0.9

{{#if prefill_chunk_size}}
      # Prefill chunk size for long-context requests.
      # Reduces memory spikes during prompt processing.
      prefill_chunk_size: {{prefill_chunk_size}}
{{/if}}

{{#if turboquant_enabled}}
    # ---------------------------------------------------------------------------
    # TurboQuant KV-Cache Compression
    # ---------------------------------------------------------------------------
    # Google Research (ICLR 2026): PolarQuant + QJL algorithms
    # Compresses KV-cache to {{turboquant_bits}} bits per value.
    # Effect: ~{{compression_ratio}}x memory reduction → ~{{effective_context_k}}K effective context
    # Quality impact: <0.1% on standard benchmarks (bits=3 sweet spot)
    # No retraining required — applies to any supported model architecture.
    #
    # VRAM headroom at selection time: {{headroom_pct}}%
    # See: references/turboquant-guide.md for full decision table
    kvcache_compression:
      bits: {{turboquant_bits}}
      policy:
        {{turboquant_policy}}
{{/if}}

{{#if vision_enabled}}
    # Vision capability (proxy mode for vision-language models)
    capabilities:
      vision_mode: proxy
      vision_proxy:
        hf_id: {{hf_id}}
        prompt_template: "Analyze this image and respond to: "
{{/if}}

    # Parking Lot Scheduler — resource-aware request management
    parking_lot:
      pool:
        worker_threads: {{worker_threads}}
      limits:
        max_units: {{max_units}}         # Max KV-cache blocks
        max_queue_depth: {{max_queue_depth}}
        timeout_secs: 300
      queue:
        backend: "memory"
        persistence: false
      mailbox:
        backend: "memory"
        retention_secs: 3600

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
# Start candle-vllm with this config:
#   candle-vllm --models-config candle-vllm-models.yaml --port 3000
#
# Verify model loaded:
#   curl http://localhost:3000/v1/models
#
# Test inference:
#   curl http://localhost:3000/v1/chat/completions \
#     -H "Content-Type: application/json" \
#     -d '{"model":"{{model_name}}","messages":[{"role":"user","content":"Hello!"}]}'
#
# Then configure UAR to use it:
#   UAR_LLM__MODEL=candle-vllm/{{model_name}}
#   UAR_LLM__BASE_URL=http://localhost:3000
#   UAR_LLM__PROTOCOL=chat
