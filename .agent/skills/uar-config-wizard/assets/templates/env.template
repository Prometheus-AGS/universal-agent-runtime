# Universal Agent Runtime — Environment Variables
# Generated by /uar-config-wizard
# Full reference: .agent/skills/uar-config-wizard/references/env-vars.md
#
# Precedence: UAR_* vars > LLM_* legacy vars > provider shortcuts > config.yaml > defaults

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
UAR_PERSISTENCE__DATABASE_URL=<REPLACE: {{db_connection_pattern}}>

{{#if redis_enabled}}
UAR_PERSISTENCE__REDIS_URL=<REPLACE: redis://localhost:6379>
UAR_PERSISTENCE__EXTERNAL_CACHE_ENABLED=true
{{/if}}

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 64
UAR_SECURITY__JWT_SECRET=<GENERATE: openssl rand -base64 64>
UAR_SECURITY__JWT_REQUIRED={{jwt_required}}

# ---------------------------------------------------------------------------
# LLM Configuration
# ---------------------------------------------------------------------------
UAR_LLM__MODEL={{llm_model}}
UAR_LLM__PROTOCOL={{llm_protocol}}
{{#if llm_base_url}}
UAR_LLM__BASE_URL={{llm_base_url}}
{{/if}}
{{#if llm_timeout}}
UAR_LLM__TIMEOUT_SECS={{llm_timeout}}
{{/if}}

# Provider API keys — set whichever applies to your chosen provider(s).
# These are auto-detected shortcuts; UAR_LLM__API_KEY takes precedence if set.
{{#if uses_openai}}
OPENAI_API_KEY=<REPLACE: your OpenAI API key from platform.openai.com>
{{/if}}
{{#if uses_anthropic}}
ANTHROPIC_API_KEY=<REPLACE: your Anthropic API key from console.anthropic.com>
{{/if}}
{{#if uses_groq}}
GROQ_API_KEY=<REPLACE: your Groq API key from console.groq.com>
{{/if}}
{{#if uses_mistral}}
MISTRAL_API_KEY=<REPLACE: your Mistral API key from console.mistral.ai>
{{/if}}
{{#if uses_gemini}}
GEMINI_API_KEY=<REPLACE: your Google AI API key from aistudio.google.com>
{{/if}}
{{#if uses_cohere}}
COHERE_API_KEY=<REPLACE: your Cohere API key from dashboard.cohere.ai>
{{/if}}
{{#if uses_together}}
TOGETHER_API_KEY=<REPLACE: your Together AI API key from api.together.xyz>
{{/if}}

# ---------------------------------------------------------------------------
# File Processing (optional)
# ---------------------------------------------------------------------------
{{#if uses_unstructured}}
UNSTRUCTURED_API_KEY=<REPLACE: your Unstructured API key>
{{/if}}
{{#if uses_mistral_ocr}}
# MISTRAL_API_KEY already set above
{{/if}}

# ---------------------------------------------------------------------------
# Memory / SurrealDB (optional)
# ---------------------------------------------------------------------------
{{#if memory_enabled}}
UAR_MEMORY__ENABLED=true
UAR_MEMORY__DB_PATH=./data/memory.db
UAR_MEMORY__EMBEDDING_PROVIDER={{memory_embedding_provider}}
UAR_MEMORY__EMBEDDING_MODEL={{memory_embedding_model}}
UAR_MEMORY__AUTO_CAPTURE=true
{{/if}}

# ---------------------------------------------------------------------------
# Server (override config.yaml values if needed)
# ---------------------------------------------------------------------------
# UAR_SERVER__PORT={{uar_port}}
# UAR_SERVER__HOST={{uar_host}}

# ---------------------------------------------------------------------------
# Resilience (override config.yaml values if needed)
# ---------------------------------------------------------------------------
# UAR_RESILIENCE__RATE_LIMIT_ENABLED={{rate_limit_enabled}}
# UAR_RESILIENCE__REQUESTS_PER_SECOND={{requests_per_second}}

# ---------------------------------------------------------------------------
# candle-vllm (if using local inference)
# ---------------------------------------------------------------------------
{{#if uses_candle_vllm}}
# candle-vllm does not require API key auth by default.
# Set the base_url in config.yaml providers[] or via:
# UAR_LLM__BASE_URL={{candle_vllm_url}}
# UAR_LLM__PROTOCOL=chat
{{/if}}
