#!/usr/bin/env bash
# UAR + candle-vllm Quick Start Script
# Generated by /uar-config-wizard (/uar-stack)
# Platform: {{platform}}
# Model: {{model_name}} ({{hf_id}})
# TurboQuant: {{turboquant_summary}}

set -euo pipefail

CANDLE_VLLM_URL="{{candle_vllm_url}}"
UAR_PORT="{{uar_port}}"
MODEL_NAME="{{model_name}}"
MODELS_CONFIG="./candle-vllm-models.yaml"

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; NC='\033[0m'; BOLD='\033[1m'
info()    { echo -e "${CYAN}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }
error()   { echo -e "${RED}[ERROR]${NC} $*"; exit 1; }

# ---------------------------------------------------------------------------
# Prerequisite checks
# ---------------------------------------------------------------------------
echo -e "${BOLD}UAR + candle-vllm Quick Start${NC}"
echo "========================================"

# Check required env vars
check_env() {
  local var="$1"
  if [ -z "${!var:-}" ]; then
    error "Required environment variable $var is not set. Check your .env file."
  fi
  success "$var is set"
}

if [ -f ".env" ]; then
  info "Loading .env..."
  # shellcheck disable=SC1091
  set -o allexport && source .env && set +o allexport
else
  warn "No .env found in current directory. Relying on exported environment variables."
fi

info "Checking required environment variables..."
check_env "UAR_PERSISTENCE__DATABASE_URL"
check_env "UAR_SECURITY__JWT_SECRET"

{{#if uses_openai}}
check_env "OPENAI_API_KEY"
{{/if}}
{{#if uses_anthropic}}
check_env "ANTHROPIC_API_KEY"
{{/if}}

# Validate JWT secret is not default
if [[ "${UAR_SECURITY__JWT_SECRET:-}" =~ ^(secret_key_change_me|fallback_secret)$ ]]; then
  error "UAR_SECURITY__JWT_SECRET is still the default placeholder. Generate a real secret:\n  export UAR_SECURITY__JWT_SECRET=\$(openssl rand -base64 64)"
fi

# Check models config
if [ ! -f "$MODELS_CONFIG" ]; then
  error "candle-vllm models config not found: $MODELS_CONFIG\nExpected: $(pwd)/candle-vllm-models.yaml"
fi

echo ""

# ---------------------------------------------------------------------------
# Step 1: Start candle-vllm
# ---------------------------------------------------------------------------
echo -e "${BOLD}Step 1: Starting candle-vllm${NC}"
info "Model: $MODEL_NAME"
info "Config: $MODELS_CONFIG"
info "URL: $CANDLE_VLLM_URL"

# Determine if candle-vllm is already running
if curl -sf "${CANDLE_VLLM_URL}/v1/models" > /dev/null 2>&1; then
  success "candle-vllm is already running at $CANDLE_VLLM_URL"
else
  info "Starting candle-vllm..."

{{#if platform_cuda}}
  # CUDA launch
  candle-vllm \
    --models-config "$MODELS_CONFIG" \
    --model-alias "$MODEL_NAME" \
    --port 3000 &
  CANDLE_PID=$!
{{/if}}
{{#if platform_metal}}
  # Apple Silicon (Metal) launch
  candle-vllm \
    --models-config "$MODELS_CONFIG" \
    --model-alias "$MODEL_NAME" \
    --port 3000 &
  CANDLE_PID=$!
{{/if}}
{{#if platform_cpu}}
  # CPU-only launch (slow — for testing only)
  candle-vllm \
    --models-config "$MODELS_CONFIG" \
    --model-alias "$MODEL_NAME" \
    --port 3000 &
  CANDLE_PID=$!
{{/if}}

  info "candle-vllm PID: $CANDLE_PID"
  info "Waiting for model to load (this may take several minutes for large models)..."

  ATTEMPTS=0
  MAX_ATTEMPTS=60
  while ! curl -sf "${CANDLE_VLLM_URL}/v1/models" > /dev/null 2>&1; do
    sleep 5
    ATTEMPTS=$((ATTEMPTS + 1))
    if [ "$ATTEMPTS" -ge "$MAX_ATTEMPTS" ]; then
      error "candle-vllm failed to start after $((MAX_ATTEMPTS * 5)) seconds. Check logs above."
    fi
    echo -n "."
  done
  echo ""
  success "candle-vllm is ready"
fi

# Verify model is loaded
LOADED_MODELS=$(curl -sf "${CANDLE_VLLM_URL}/v1/models" | python3 -c "import json,sys; models=json.load(sys.stdin).get('data',[]); print([m['id'] for m in models])" 2>/dev/null || echo "unknown")
info "Loaded models: $LOADED_MODELS"

echo ""

# ---------------------------------------------------------------------------
# Step 2: Quick inference test
# ---------------------------------------------------------------------------
echo -e "${BOLD}Step 2: Testing candle-vllm inference${NC}"
TEST_RESPONSE=$(curl -sf "${CANDLE_VLLM_URL}/v1/chat/completions" \
  -H "Content-Type: application/json" \
  -d "{\"model\":\"${MODEL_NAME}\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: READY\"}],\"max_tokens\":10}" \
  2>/dev/null || echo "FAILED")

if echo "$TEST_RESPONSE" | grep -q "READY\|ready"; then
  success "Model inference test passed"
else
  warn "Inference test did not return expected response. candle-vllm may still be warming up."
  info "Raw response: $TEST_RESPONSE"
fi

echo ""

# ---------------------------------------------------------------------------
# Step 3: Start UAR
# ---------------------------------------------------------------------------
echo -e "${BOLD}Step 3: Starting UAR${NC}"
info "Port: $UAR_PORT"
info "LLM model: {{llm_model}}"
info "LLM base_url: $CANDLE_VLLM_URL"

uar --config ./config.yaml &
UAR_PID=$!
info "UAR PID: $UAR_PID"

info "Waiting for UAR to be ready..."
ATTEMPTS=0
while ! curl -sf "http://localhost:${UAR_PORT}/health" > /dev/null 2>&1; do
  sleep 2
  ATTEMPTS=$((ATTEMPTS + 1))
  if [ "$ATTEMPTS" -ge 30 ]; then
    error "UAR failed to start after 60 seconds. Check logs above."
  fi
  echo -n "."
done
echo ""
success "UAR is ready"

echo ""

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo -e "${BOLD}Stack is running! 🚀${NC}"
echo "========================================"
echo -e "  candle-vllm:  ${CYAN}${CANDLE_VLLM_URL}${NC}"
echo -e "  UAR API:      ${CYAN}http://localhost:${UAR_PORT}${NC}"
echo -e "  Model:        ${CYAN}${MODEL_NAME}${NC}"
{{#if turboquant_enabled}}
echo -e "  TurboQuant:   ${CYAN}{{turboquant_bits}}-bit compression (~{{compression_ratio}}x context expansion)${NC}"
{{/if}}
echo ""
echo "Test UAR directly:"
echo "  curl http://localhost:${UAR_PORT}/health"
echo ""
echo "Send a chat request:"
cat << 'CURL_EXAMPLE'
  curl http://localhost:{{uar_port}}/v1/chat/completions \
    -H "Content-Type: application/json" \
{{#if jwt_required}}
    -H "Authorization: Bearer <your-jwt-token>" \
{{/if}}
    -d '{"model":"candle-vllm/{{model_name}}","messages":[{"role":"user","content":"Hello!"}]}'
CURL_EXAMPLE
echo ""
echo "Stop both services:"
echo "  kill $UAR_PID $CANDLE_PID"
