# Universal Agent Runtime — Configuration File
# Generated by /uar-config-wizard
# Full reference: .agent/skills/uar-config-wizard/references/config-reference.md
#
# Precedence: CLI args > UAR_* env vars > LLM_* legacy vars > this file > compiled defaults

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
server:
  # HTTP port to listen on.
  # Env: UAR_SERVER__PORT | CLI: --port
  port: {{uar_port}}

  # Bind address. Use 0.0.0.0 for Docker/K8s, 127.0.0.1 for local-only.
  # Env: UAR_SERVER__HOST
  host: "{{uar_host}}"

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
security:
  # Require Bearer JWT token on all API requests.
  # Env: UAR_SECURITY__JWT_REQUIRED | CLI: --jwt-required
  jwt_required: {{jwt_required}}

  # HMAC signing secret. NEVER use the default in production.
  # Generate: openssl rand -base64 64
  # Env: UAR_SECURITY__JWT_SECRET
  jwt_secret: "<GENERATE: openssl rand -base64 64>"

# ---------------------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------------------
resilience:
  # Token-bucket rate limiter.
  # Env: UAR_RESILIENCE__RATE_LIMIT_ENABLED | CLI: --rate-limit-enabled
  rate_limit_enabled: {{rate_limit_enabled}}
  requests_per_second: {{requests_per_second}}
  burst_size: {{burst_size}}

  # Request timeout middleware.
  # Env: UAR_RESILIENCE__TIMEOUT_DISABLED | CLI: --timeout-disabled
  timeout_disabled: false
  request_timeout_ms: 30000
  stream_start_timeout_ms: 15000

  # Automatic retry with exponential backoff.
  retries_enabled: true
  retry_max_attempts: 3
  retry_base_delay_ms: 1000
  retry_backoff_multiplier: 2.0
  retry_max_delay_ms: 10000
  retry_jitter_mode: "full"
  retryable_http_statuses: [408, 425, 429, 500, 502, 503, 504]

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
persistence:
  # Database backend: "postgres" (default) or "surreal"
  # Env: UAR_PERSISTENCE__PROVIDER
  provider: "{{db_provider}}"

  # Database connection string.
  # Env: UAR_PERSISTENCE__DATABASE_URL
  database_url: "<REPLACE: {{db_connection_pattern}}>"

  # Redis external cache (optional).
  # Env: UAR_PERSISTENCE__EXTERNAL_CACHE_ENABLED | CLI: --external-cache-enabled
  external_cache_enabled: {{external_cache_enabled}}
{{#if redis_url}}
  redis_url: "<REPLACE: your Redis connection string>"
{{/if}}

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
llm:
  # Model in "provider/model" format.
  # See: https://models.dev for all available models.
  # Env: UAR_LLM__MODEL | LLM_MODEL | CLI: --llm-model
  model: "{{llm_model}}"

  # API key for the default provider.
  # Env: UAR_LLM__API_KEY | LLM_API_KEY | CLI: --llm-api-key
  # Or use provider shortcut: OPENAI_API_KEY, ANTHROPIC_API_KEY, etc.
  # api_key: "<REPLACE: your API key>"  # Recommended: set via env var instead

  # Override provider endpoint. Required for candle-vllm, Ollama, or proxies.
  # Env: UAR_LLM__BASE_URL | LLM_BASE_URL | CLI: --llm-base-url
{{#if llm_base_url}}
  base_url: "{{llm_base_url}}"
{{/if}}

  # Protocol: "auto" (detect) | "chat" (OpenAI chat completions) | "responses" (Anthropic/OpenAI responses)
  # Use "chat" for candle-vllm, Ollama, and most local servers.
  # Env: UAR_LLM__PROTOCOL | LLM_PROTOCOL | CLI: --llm-protocol
  protocol: "{{llm_protocol}}"

  # Timeout in seconds. Increase for slow local models.
  # Env: UAR_LLM__TIMEOUT_SECS
  timeout_secs: {{llm_timeout_secs}}

  # Max retries on 429/5xx responses.
  max_retries: {{llm_max_retries}}

  # Response cache (Tower middleware).
  cache:
    enabled: false
    ttl_secs: 300
    max_size: 1000

# ---------------------------------------------------------------------------
# Providers (multi-provider routing)
# ---------------------------------------------------------------------------
{{#if candle_vllm_provider_block}}
providers:
  - id: "candle-vllm"
    display_name: "Local candle-vllm"
    base_url: "{{candle_vllm_url}}"
    # candle-vllm does not require auth by default
    api_key: ""
    # MUST be "chat" — candle-vllm implements OpenAI chat completions API
    protocol: chat
    default_model: "{{selected_model_name}}"
    enabled: true
    models:
      - id: "{{selected_model_name}}"
        context_window: {{context_window}}
        supports_vision: {{supports_vision}}
        supports_tools: {{supports_tools}}
{{/if}}

# ---------------------------------------------------------------------------
# Vision (optional)
# ---------------------------------------------------------------------------
vision:
  # Vision model for image understanding.
  # Env: UAR_VISION__MODEL
  # model: "openai/gpt-4o"
  auto_detect: {{vision_auto_detect}}

# ---------------------------------------------------------------------------
# File Processing (optional)
# ---------------------------------------------------------------------------
{{#if file_processing_enabled}}
file_processing:
  # Provider: "auto" | "unstructured" | "mistral" | "kreuzberg"
  provider: "auto"
  upload_dir: "/tmp/uar-uploads"
  max_file_size: 52428800    # 50MB
  max_total_size: 104857600  # 100MB
{{/if}}

# ---------------------------------------------------------------------------
# Memory (optional — requires SurrealDB)
# ---------------------------------------------------------------------------
{{#if memory_enabled}}
memory:
  enabled: true

  # Embedded SurrealDB path (single-node) or server endpoint (cluster).
  db_path: "./data/memory.db"
  # surreal_endpoint: "ws://localhost:8000/rpc"  # Uncomment for server mode

  # Embedding provider for semantic search.
  # "openai" | "cohere" | "local"
  embedding_provider: "openai"
  embedding_model: "text-embedding-3-small"

  # Automatically extract memories after each conversation turn.
  auto_capture: true

  # Inject relevant memories into system prompt context.
  inject_context: true
  max_context_tokens: 2000

  # Hybrid search weights (must sum to ≤ 1.0).
  vector_weight: 0.7
  bm25_weight: 0.3
{{/if}}
