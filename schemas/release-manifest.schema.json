{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Prometheus-AGS/universal-agent-runtime/schemas/release-manifest.schema.json",
  "title": "Universal Agent Runtime release evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release", "source", "builder", "signing", "artifacts", "image", "evidence", "promotion", "support_matrix"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "release": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sha", "git_tree", "cargo_lock_sha256", "catalog_sha256", "model_bundle_sha256", "model_inputs", "sboms"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "git_tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "cargo_lock_sha256": { "$ref": "#/$defs/sha256" },
        "catalog_sha256": { "$ref": "#/$defs/sha256" },
        "model_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "model_inputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "sboms": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/fileName" },
          "uniqueItems": true
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "source_sha", "receipt", "receipt_sha256"],
      "properties": {
        "kind": { "const": "local" },
        "identity": { "type": "string", "minLength": 1 },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "receipt": { "$ref": "#/$defs/fileName" },
        "receipt_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certificate_identity", "certificate_oidc_issuer"],
      "properties": {
        "certificate_identity": { "type": "string", "minLength": 1 },
        "certificate_oidc_issuer": { "type": "string", "format": "uri" }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/platformArtifact" },
          { "$ref": "#/$defs/offlineSourceArtifact" }
        ]
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "digest", "platforms", "sboms", "signature", "provenance"],
      "properties": {
        "reference": { "type": "string", "pattern": "^ghcr\\.io/" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "platforms": { "type": "array", "minItems": 2, "items": { "type": "string" }, "uniqueItems": true },
        "sboms": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/fileName" }, "uniqueItems": true },
        "signature": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/fileName" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checksums", "files", "provenance", "tests", "audits"],
      "properties": {
        "checksums": { "const": "SHA256SUMS" },
        "files": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileDigest" }, "uniqueItems": true },
        "provenance": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileName" }, "uniqueItems": true },
        "tests": { "$ref": "#/$defs/sourceEvidence" },
        "audits": { "$ref": "#/$defs/sourceEvidence" }
      }
    },
    "promotion": { "const": "promotion.json" },
    "support_matrix": { "const": "product-support-matrix.json" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fileName": { "type": "string", "pattern": "^(?!\\.)(?!.*\\.\\.)[^/\\\\]+$" },
    "fileDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": { "$ref": "#/$defs/fileName" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "source_sha"],
      "properties": {
        "name": { "$ref": "#/$defs/fileName" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "platformArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sha256", "binary", "sboms", "signature", "provenance"],
      "properties": {
        "kind": { "const": "platform-archive" },
        "name": { "$ref": "#/$defs/fileName" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "binary": { "$ref": "#/$defs/binary" },
        "sboms": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/fileName" }, "uniqueItems": true },
        "signature": { "$ref": "#/$defs/fileName" },
        "provenance": { "$ref": "#/$defs/fileName" }
      }
    },
    "offlineSourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "sha256", "sboms", "signature", "provenance"],
      "properties": {
        "kind": { "const": "offline-source" },
        "name": { "const": "uar-offline-source.tar.gz" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sboms": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/fileName" }, "uniqueItems": true },
        "signature": { "$ref": "#/$defs/fileName" },
        "provenance": { "$ref": "#/$defs/fileName" }
      }
    }
  }
}
