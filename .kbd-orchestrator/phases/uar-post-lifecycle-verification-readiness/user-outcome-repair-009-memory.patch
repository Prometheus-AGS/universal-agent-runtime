+#[cfg(feature = "surreal-backend")]
 fn transport_outcome_unknown(error: &anyhow::Error) -> bool {
     error.chain().any(|cause| {
         cause
             .downcast_ref::<surrealdb::types::Error>()
             .is_some_and(|error| error.is_connection())
     })
