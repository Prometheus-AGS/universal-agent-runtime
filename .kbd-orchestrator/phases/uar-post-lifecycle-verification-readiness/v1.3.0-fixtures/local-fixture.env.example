# PROPOSED public local fixture data, never operator credentials.
# Source under env -i only after explicit approval. Do not source into user shell.
UAR_LOCAL_ONLY=true
UAR_BOUNDARY_STORE_USER=root
UAR_BOUNDARY_STORE_PASSWORD=uar-post-lifecycle-v130-001-public-fixture-store
UAR_BOUNDARY_EXISTING_WORKSPACE=uar-post-lifecycle-v130-001-workspace
UAR_BOUNDARY_SETTINGS_ADMIN_KEY=uar-post-lifecycle-v130-001-public-fixture-admin
# Filled only by explicitly approved fixture JWT preparation; not issued yet.
UAR_BOUNDARY_OWNER_AUTHORIZATION=
UAR_BOUNDARY_OTHER_OWNER_AUTHORIZATION=
UAR_BOUNDARY_EXISTING_HOST_AUTHORIZATION=
# Do NOT set UAR_REMOTE_SURREAL_DURABILITY_ATTESTED here: trusted supervisor
# may set it to 1 only in the approved boundary launch after starting this
# exact rocksdb-backed owned store. It is an attestation, not a runtime proof.
