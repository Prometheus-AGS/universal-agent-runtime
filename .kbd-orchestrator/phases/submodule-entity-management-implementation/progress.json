  "lessons_learned": [
    {
      "id": "bash-cwd-tracking",
      "summary": "Bash tool shell cwd does not always reset after a previous invocation's cd. For cross-worktree writes, every bash invocation that writes files MUST start with an explicit cd <abs-path>. Surfaced during seim-em-worktree-setup \u00a73; recovered cleanly via mv + rmdir."
    },
    {
      "id": "bash-relative-path-failures-during-archive",
      "summary": "During /opsx:archive of seim-em-surreal-live-adapter-impl, relative-path ls/mv commands ran from the entity-mgmt worktree (cwd from prior bash invocation) instead of UAR, producing false 'directory missing' errors. Lesson: archive operations should use full absolute paths."
    },
    {
      "id": "rtl-portal-cleanup",
      "summary": "React Testing Library auto-cleanup does not remove portal content from document.body when vitest globals:false is used. Fix: add explicit afterEach(() => { cleanup(); document.body.innerHTML = ''; }) in every jsdom test file that renders portals."
    }
  ],
