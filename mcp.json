{
  "mcpServers": {
    "tavily": {
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=${TAVILY_API_KEY}",
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "surreal_memory": {
      "url": "${UAR_MEMORY_MCP_URL:-http://127.0.0.1:1906/mcp/memory}"
    },
    "kreuzberg": {
      "command": "kreuzberg",
      "args": [
        "mcp",
        "--transport",
        "stdio"
      ]
    }
  }
}