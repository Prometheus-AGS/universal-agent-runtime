##############################################################################
# UAR Local Production Stack — Environment Variables
#
# Copy this file to .env and fill in your secrets before running ./start.sh
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
##############################################################################

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=uar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=uar

# ── SurrealDB ────────────────────────────────────────────────────────────────
SURREAL_USER=root
SURREAL_PASS=changeme

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
UAR_SECURITY__JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── LLM provider ────────────────────────────────────────────────────────────
# OpenAI / compatible endpoint
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com
LLM_MODEL=gpt-4o

# ── Embeddings (used by memory system) ───────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Tools ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── File processing ──────────────────────────────────────────────────────────
# Get your key at https://unstructured.io — or leave blank to use a local
# open-source alternative (set UAR_FILE_PROCESSING__PROVIDER=local instead)
UAR_UNSTRUCTURED__API_KEY=

# ── Optional: override built-in defaults ────────────────────────────────────
# UAR_MEMORY__ENABLED=true                  (default: true in docker-compose.prod.yml)
# UAR_SECURITY__JWT_REQUIRED=false          (set to true in production with valid token)
# UAR_MODELS_DIR=/custom/path/to/models     (override tokenizer location, default: searches multiple paths)
# LLM_PROTOCOL=auto                         (auto | openai | anthropic)
