##############################################################################
# UAR Local Production Stack — Environment Variables
#
# Copy this file to .env and fill in your secrets before running ./start.sh
#
#   cp .env.example .env
#
# NEVER commit .env to version control.
##############################################################################

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=uar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=uar

# ── SurrealDB ────────────────────────────────────────────────────────────────
SURREAL_USER=root
SURREAL_PASS=changeme

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 64
UAR_SECURITY__JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# ── LLM configuration (liter-llm unified client) ────────────────────────────
# Primary way to configure the LLM (new style — UAR_LLM__* env vars):
UAR_LLM__MODEL=openai/gpt-4o          # provider/model format — see models.dev
UAR_LLM__API_KEY=sk-...               # API key for the provider
# UAR_LLM__BASE_URL=                  # Base URL override (e.g. for Ollama, LM Studio)
# UAR_LLM__TIMEOUT_SECS=60
# UAR_LLM__MAX_RETRIES=3
# UAR_LLM__COST_TRACKING=false
# UAR_LLM__TRACING=true

# Provider-specific API key shortcuts (automatically mapped by UAR):
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
MISTRAL_API_KEY=...
# COHERE_API_KEY=...
# GEMINI_API_KEY=...
# TOGETHER_API_KEY=...
# PERPLEXITY_API_KEY=...

# Backward-compatible legacy vars (still supported, lower priority than UAR_LLM__*):
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o

# ── Tools ────────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ── File processing ──────────────────────────────────────────────────────────
# Get your key at https://unstructured.io — or leave blank to use a local
# open-source alternative (set UAR_FILE_PROCESSING__PROVIDER=local instead)
UAR_UNSTRUCTURED__API_KEY=

# ── Optional: override built-in defaults ────────────────────────────────────
# UAR_MEMORY__ENABLED=true                  (default: true in docker-compose.prod.yml)
# UAR_SECURITY__JWT_REQUIRED=false          (set to true in production with valid token)
# UAR_MODELS_DIR=/custom/path/to/models     (override tokenizer location, default: searches multiple paths)
