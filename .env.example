##############################################################################
# Universal Agent Runtime — Environment Variables
#
# Copy to `.env` and adjust for your environment:
#   cp .env.example .env
#
# Config file (optional): point at a YAML file; see `example.config.yaml`,
# `config.embedded.yaml`, `config.remote.surreal.yaml`, `config.remote.postgres.yaml`.
#   export CONFIG_FILE=/path/to/config.yaml
#
# UAR uses the `UAR_` prefix with `__` for nesting (e.g. `UAR_SERVER__PORT`).
# NEVER commit `.env` with real secrets.
##############################################################################

# ── Config file (optional; CLI: --config path) ──────────────────────────────
# CONFIG_FILE=/absolute/path/to/your/config.yaml

# ── Server ─────────────────────────────────────────────────────────────────
# UAR_SERVER__PORT=3000
# UAR_SERVER__HOST=0.0.0.0
# UAR_SERVER__GRPC_PORT=50051

# ── PostgreSQL (docker-compose / external Postgres for UAR or other services) ─
POSTGRES_USER=uar
POSTGRES_PASSWORD=changeme
POSTGRES_DB=uar

# ── Persistence (UAR application data: sessions, skills, KB, etc.) ───────────
# Provider: `postgres` | `surreal` (see example YAML files under repo root).
# UAR_PERSISTENCE__PROVIDER=surreal
# UAR_PERSISTENCE__DATABASE_URL=rocksdb://./data/uar-db
# UAR_PERSISTENCE__VECTOR_DIMENSION=384
# UAR_PERSISTENCE__EXTERNAL_CACHE_ENABLED=false
# Optional: remote SurrealDB (http/https/ws/wss) credentials — ignored for rocksdb/file URLs.
# UAR_PERSISTENCE__SURREAL_USER=root
# UAR_PERSISTENCE__SURREAL_PASS=changeme

# Example Postgres URL (matches POSTGRES_* above when using docker-compose):
# UAR_PERSISTENCE__PROVIDER=postgres
# UAR_PERSISTENCE__DATABASE_URL=postgres://uar:changeme@localhost:5432/uar

# Example remote SurrealDB (HTTP or WebSocket endpoint):
# UAR_PERSISTENCE__PROVIDER=surreal
# UAR_PERSISTENCE__DATABASE_URL=http://127.0.0.1:8000

# ── Redis (only if persistence.external_cache_enabled / session cache) ─────
# UAR_PERSISTENCE__REDIS_URL=redis://localhost:6379

# ── SurrealDB server (separate from UAR — e.g. standalone Surreal container) ─
SURREAL_USER=root
SURREAL_PASS=changeme

# ── Security ────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 64
UAR_SECURITY__JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
# UAR_SECURITY__JWT_REQUIRED=true

# ── LLM (liter-llm) — primary: UAR_LLM__* ────────────────────────────────────
UAR_LLM__MODEL=openai/gpt-4o
UAR_LLM__API_KEY=sk-replace-me
# UAR_LLM__BASE_URL=
# UAR_LLM__TIMEOUT_SECS=60
# UAR_LLM__MAX_RETRIES=3
# UAR_LLM__COST_TRACKING=false
# UAR_LLM__TRACING=true

# Provider shortcuts (mapped when UAR_LLM__API_KEY is unset):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# MISTRAL_API_KEY=
# GEMINI_API_KEY=

# Legacy (lower priority than UAR_LLM__*):
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# ── Model failover (orchestrator — optional) ─────────────────────────────────
# UAR_FAILOVER__ENABLED=false
# UAR_FAILOVER__STRATEGY=priority

# ── Native in-process tools (optional CLI overrides; YAML `native_tools:` preferred)
# UAR_NATIVE_TOOLS__FILE_TOOLS_ENABLED=false
# UAR_NATIVE_TOOLS__WEB_FETCH_ENABLED=false
# UAR_NATIVE_TOOLS__TERMINAL_EXEC_ENABLED=false

# ── Skill evolution (post-run reflection → skills) ───────────────────────────
# UAR_SKILL_EVOLUTION__ENABLED=false
# UAR_SKILL_EVOLUTION__TRIGGER_MODEL=openai/gpt-4o-mini

# ── ACP (Agent Communication Protocol) JSON-RPC endpoint ─────────────────────
# UAR_ACP__ENABLED=false
# UAR_ACP__PATH=/acp

# ── Tools (MCP / integrations) ──────────────────────────────────────────────
TAVILY_API_KEY=

# ── File processing ───────────────────────────────────────────────────────────
# UAR_UNSTRUCTURED__API_KEY=
# UAR_FILE_PROCESSING__PROVIDER=auto

# ── Memory / optional services ────────────────────────────────────────────────
# UAR_MEMORY__ENABLED=true
# UAR_MODELS_DIR=
