    },
    "./processing": {
      "types": "./src/processing/index.ts",
      "default": "./src/processing/index.ts"
    },
    "./resolution": {
      "types": "./src/resolution/index.ts",
      "default": "./src/resolution/index.ts"
    },
    "./rendering": {
      "types": "./src/resolution/index.ts",
      "default": "./src/resolution/index.ts"
