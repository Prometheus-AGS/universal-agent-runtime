    },
    "./v0_9": {
      "types": "./src/v0_9/index.ts",
      "default": "./src/v0_9/index.ts"
    },
    "./v0_9/universal": {
      "types": "./src/v0_9/universal/index.ts",
      "default": "./src/v0_9/universal/index.ts"
    },
    "./v0_9/basic_catalog": {
      "types": "./src/v0_9/basic_catalog/index.ts",
      "default": "./src/v0_9/basic_catalog/index.ts"
    },
    "./v1_0": {
      "types": "./src/v1_0/index.ts",
      "default": "./src/v1_0/index.ts"
    },
    "./catalogs/basic/v1": {
      "types": "./src/catalogs/basic/v1/index.ts",
      "default": "./src/catalogs/basic/v1/index.ts"
