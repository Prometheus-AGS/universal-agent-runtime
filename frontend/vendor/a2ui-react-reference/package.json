{
  "name": "@prometheus-ags/a2ui-react-reference-zod4",
  "version": "0.14.0-rc.1",
  "license": "Apache-2.0",
  "description": "React renderer for A2UI (Agent-to-User Interface)",
  "homepage": "https://a2ui.org/",
  "repository": {
    "directory": "typescript/renderers/react",
    "type": "git",
    "url": "git+https://github.com/a2ui-project/a2ui.git"
  },
  "bugs": {
    "url": "https://github.com/a2ui-project/a2ui/issues"
  },
  "keywords": [
    "a2ui",
    "react",
    "ai",
    "agent",
    "ui",
    "renderer"
  ],
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./index.cjs"
      }
    },
    "./v0_8": {
      "import": {
        "types": "./v0_8/index.d.ts",
        "default": "./v0_8/index.js"
      },
      "require": {
        "types": "./v0_8/index.d.cts",
        "default": "./v0_8/index.cjs"
      }
    },
    "./v0_9": {
      "import": {
        "types": "./v0_9/index.d.ts",
        "default": "./v0_9/index.js"
      },
      "require": {
        "types": "./v0_9/index.d.cts",
        "default": "./v0_9/index.cjs"
      }
    },
    "./styles": {
      "import": {
        "types": "./styles/index.d.ts",
        "default": "./styles/index.js"
      },
      "require": {
        "types": "./styles/index.d.cts",
        "default": "./styles/index.cjs"
      }
    },
    "./styles/structural.css": "./structural.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@a2ui/web_core": "workspace:@prometheus-ags/a2ui-web-core-zod4@0.14.0-rc.1",
    "clsx": "^2.1.1",
    "markdown-it": "14.3.3"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "private": true
}
