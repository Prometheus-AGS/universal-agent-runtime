{
  "name": "uar-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:manifest": "vite build --manifest",
    "budget:bundle": "node ../scripts/check-frontend-budgets.mjs",
    "budget:proofs": "node ../scripts/build-pglite-seed.mjs --check && node ../scripts/test-frontend-budget-gate.mjs && vitest run src/test/performance-budget.test.ts",
    "budget:performance": "playwright test -c playwright.performance.config.ts --workers=1 && vitest run --project=storybook src/features/chat/ui/run-trace-timeline.stories.tsx src/shared/markdown/markdown-bubble.stories.tsx --maxWorkers=1 --reporter=default --reporter=json --outputFile=../openspec/changes/a11y-and-responsive-certification/receipts/performance-storybook.json",
    "pglite:seed": "node ../scripts/build-pglite-seed.mjs",
    "pglite:seed:check": "node ../scripts/build-pglite-seed.mjs --check",
    "settings:structure": "node ../scripts/check-settings-ui-decomposition.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p packages/uar-ui/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project=unit",
    "test:e2e": "playwright test",
    "test:a11y": "node ../scripts/run-storybook-a11y-suppression-gate.mjs && playwright test -c playwright.accessibility.config.ts",
    "test:e2e:real-provider-route": "playwright test -c playwright.real-server.config.ts e2e/provider-route-real.spec.ts",
    "test:e2e:real-knowledge-rag": "playwright test -c playwright.real-server.config.ts e2e/knowledge-rag-real.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "chromatic:playwright": "chromatic --playwright --exit-zero-on-changes",
    "test:e2e:chromatic": "playwright test && chromatic --playwright --exit-zero-on-changes"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.32",
    "@assistant-ui/react-markdown": "0.14.24",
    "@base-ui/react": "1.9.0",
    "@electric-sql/pglite": "^0.5.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "@prometheus-ags/a2ui-core": "workspace:*",
    "@prometheus-ags/a2ui-uar": "workspace:*",
    "@prometheus-ags/entity-graph-core": "4.3.0",
    "@prometheus-ags/prometheus-entity-management": "4.3.0",
    "@prometheus-ags/uar-ui": "workspace:*",
    "@tanstack/react-table": "^9.3.1",
    "@tanstack/react-virtual": "3.14.23",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "embla-carousel-react": "^8.6.0",
    "immer": "^11.2.9",
    "input-otp": "^1.5.0",
    "katex": "^0.19.1",
    "loro-crdt": "1.13.9",
    "lucide-react": "^1.62.0",
    "mermaid": "^12.2.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4",
    "react-router": "^8.5.1",
    "recharts": "3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "3.25.76",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^1.0.0",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vitest/ui": "5.0.5",
    "axe-core": "4.14.0",
    "chromatic": "^18.13.3",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "storybook": "^10.6.5",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
