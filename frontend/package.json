{
  "name": "uar-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:manifest": "vite build --manifest",
    "budget:bundle": "node ../scripts/check-frontend-budgets.mjs",
    "budget:proofs": "node ../scripts/build-pglite-seed.mjs --check && node ../scripts/test-frontend-budget-gate.mjs && vitest run src/test/performance-budget.test.ts",
    "budget:performance": "playwright test -c playwright.performance.config.ts --workers=1 && vitest run --project=storybook src/features/chat/ui/run-trace-timeline.stories.tsx src/shared/markdown/markdown-bubble.stories.tsx --maxWorkers=1 --reporter=default --reporter=json --outputFile=../openspec/changes/a11y-and-responsive-certification/receipts/performance-storybook.json",
    "pglite:seed": "node ../scripts/build-pglite-seed.mjs",
    "pglite:seed:check": "node ../scripts/build-pglite-seed.mjs --check",
    "settings:structure": "node ../scripts/check-settings-ui-decomposition.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --project=unit",
    "test:e2e": "playwright test",
    "test:a11y": "node ../scripts/run-storybook-a11y-suppression-gate.mjs && playwright test -c playwright.accessibility.config.ts",
    "test:e2e:real-provider-route": "playwright test -c playwright.real-server.config.ts e2e/provider-route-real.spec.ts",
    "test:e2e:real-knowledge-rag": "playwright test -c playwright.real-server.config.ts e2e/knowledge-rag-real.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "chromatic:playwright": "chromatic --playwright --exit-zero-on-changes",
    "test:e2e:chromatic": "playwright test && chromatic --playwright --exit-zero-on-changes"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.15",
    "@assistant-ui/react-markdown": "0.14.11",
    "@base-ui/react": "1.7.0",
    "@electric-sql/pglite": "^0.5.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@prometheus-ags/prometheus-entity-management": "workspace:*",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "3.14.9",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.14",
    "embla-carousel-react": "^8.6.0",
    "immer": "^11.1.4",
    "input-otp": "^1.5.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.17.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.84.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4",
    "react-router": "^8.3.0",
    "recharts": "3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@chromatic-com/playwright": "^0.14.12",
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.9",
    "@storybook/react-vite": "^10.5.9",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "^4.1.11",
    "axe-core": "4.13.0",
    "chromatic": "^18.5.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "eslint-plugin-storybook": "^10.5.9",
    "eslint-plugin-unicorn": "73.0.0",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.1",
    "storybook": "^10.5.9",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "4.1.10"
  }
}
