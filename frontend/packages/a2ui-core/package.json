{
  "name": "@prometheus-ags/a2ui-core",
  "version": "0.10.4",
  "private": true,
  "type": "module",
  "description": "UAR wrapper for the Zod 4 port of the A2UI web core rendering and state-management library. See UPSTREAM.md for provenance.",
  "license": "Apache-2.0",
  "author": "Google LLC (upstream, https://github.com/a2ui-project/a2ui); vendored by Prometheus AGS",
  "homepage": "https://a2ui.org/",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./v0_8": {
      "types": "./src/v0_8.ts",
      "default": "./src/v0_8.ts"
    },
    "./v0_9": {
      "types": "./src/v0_9.ts",
      "default": "./src/v0_9.ts"
    },
    "./v0_9/basic_catalog": {
      "types": "./src/v0_9-basic-catalog.ts",
      "default": "./src/v0_9-basic-catalog.ts"
    },
    "./semantic-dom": {
      "types": "./src/semantic-dom.ts",
      "default": "./src/semantic-dom.ts"
    },
    "./conformance": {
      "types": "./src/conformance.ts",
      "default": "./src/conformance.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@a2ui/web_core": "workspace:@prometheus-ags/a2ui-web-core-zod4@0.14.0-rc.1"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
