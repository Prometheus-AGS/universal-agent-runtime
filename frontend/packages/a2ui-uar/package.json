{
  "name": "@prometheus-ags/a2ui-uar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UAR-owned React renderer for the A2UI protocol (uar.a2ui/1), built directly on @prometheus-ags/a2ui-core (@a2ui/web_core). Uses shadcn/ui as the visual baseline and react-aria-components for accessibility primitives that shadcn/Base UI does not cover (multi-select ChoicePicker). This is the renderer UAR product code should import — @prometheus-ags/a2ui-react is a reference implementation only.",
  "license": "Apache-2.0",
  "sideEffects": ["./src/styles.css"],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@prometheus-ags/a2ui-core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "26.4.0",
    "lucide-react": "^0.575.0",
    "motion": "13.1.1",
    "react-aria-components": "^1.20.0",
    "tailwind-merge": "^2.6.0",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@prometheus-ags/a2ui-react": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "4.13.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
