    "mode": "selected",
    "artifacts": [],
    "history": "none",
    "memoryScopes": []
  },
  "requestedLimits": {
    "concurrentTurns": 1,
    "maxMembers": 2,
    "maxDepth": 1,
    "maxPendingTasks": 8
  },
  "modelRequirements": {
