{
  "profile": "urn:prometheus:uar:collaboration:0.1.0-draft.1",
  "kind": "TeamDefinition",
  "id": "urn:uar:example:dev/design-team",
  "version": "1.0.0",
  "provenance": {
    "source": "UAR collaboration official draft illustrative examples",
    "authors": [
      "Prometheus-AGS"
    ]
  },
  "requiredCapabilities": [
    "uar.collaboration.local.v1"
  ],
  "extensions": {},
  "title": "Design subteam",
  "purpose": "Produce a bounded design artifact for a parent development task.",
  "members": [
    {
      "role": "coordinator",
      "kind": "agent",
      "definition": {
        "id": "urn:uar:example:dev/design-coordinator",
        "version": "1.0.0",
        "digest": "sha256:fb45e380ac19640bad22639ef4bdef83dab89b5788680b1cc308081baff5b664"
      },
      "min": 1,
      "max": 1,
      "responsibility": "Return a design artifact."
    },
    {
      "role": "designer",
      "kind": "agent",
      "definition": {
        "id": "urn:uar:example:dev/designer",
        "version": "1.0.0",
        "digest": "sha256:cbf912030fba3c58ee88ac9f33bb0dfb5d82780e1fd750d5738186e5512a6ff4"
      },
      "min": 1,
      "max": 1,
      "responsibility": "Design assigned interfaces."
    }
  ],
  "coordinatorRole": "coordinator",
  "communication": [
    {
      "fromRole": "coordinator",
      "toRole": "designer",
      "modes": [
        "queue-only",
        "trigger-turn"
      ]
    },
    {
      "fromRole": "designer",
      "toRole": "coordinator",
      "modes": [
        "queue-only"
      ]
    }
  ],
  "taskAcceptance": {
    "mode": "coordinator-within-binding",
    "allowedWorkflows": [
      {
        "id": "urn:uar:example:dev/design-workflow",
        "version": "1.0.0",
        "digest": "sha256:6995760c24d0eb377f1bd58446910f6c2a0c1014d971484a5a6ba76de2b51858"
      }
    ]
  },
  "routing": {
    "eligibilityFirst": true,
    "strategy": "operator-role-capacity-cost-stable-id",
    "explain": true
  },
  "limits": {
    "concurrentTurns": 4,
    "maxMembers": 16,
    "maxDepth": 3,
    "maxPendingTasks": 1000
  },
  "budget": {
    "maxTokens": 250000,
    "maxCostMicrounits": 25000000,
    "currency": "USD",
    "maxElapsedSeconds": 7200
  },
  "input": {
    "type": "object",
    "properties": {
      "brief": {
        "type": "string"
      }
    },
    "required": [
      "brief"
    ],
    "additionalProperties": false
  },
  "output": {
    "type": "object",
    "properties": {
      "artifact": {
        "type": "string"
      }
    },
    "required": [
      "artifact"
    ],
    "additionalProperties": false
  },
  "contentDigest": "sha256:3429bed3ddfa91fcb7674715bf5fd5cfc73c4d14d67af8d7a9a734cda3d69963"
}
