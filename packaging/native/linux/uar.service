[Unit]
Description=Prometheus Universal Agent Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uar
Group=uar
WorkingDirectory=/var/lib/uar
EnvironmentFile=/etc/uar/uar.env
Environment=UAR_SERVER__HOST=127.0.0.1
Environment=UAR_SERVER__GRPC_PORT=50051
Environment=PORT=1906
Environment=UAR_LOG_FILE=/var/lib/uar/.prometheus/logs/operational.log
ExecStart=/usr/local/lib/uar/universal-agent-runtime --config /etc/uar/config.yaml --env-file /etc/uar/uar.env --port 1906
KillSignal=SIGTERM
TimeoutStopSec=35s
Restart=on-failure
RestartSec=5s
StandardOutput=append:/var/lib/uar/.prometheus/logs/stdout.log
StandardError=append:/var/lib/uar/.prometheus/logs/stderr.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/uar

[Install]
WantedBy=multi-user.target
