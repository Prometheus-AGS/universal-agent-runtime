    "openai_embeddings": {"limit_microunits": 10000000},
    "liter": {"limit_microunits": 0}
  },
  "limits": {
    "model_attempts": 0,
    "embedding_attempts": 0,
    "generated_tokens": 0,
    "cost_microunits": 0,
