{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uar:runtime-measurement:manifest:1",
  "title": "Owner selection for the existing Cucumber runtime measurement feature",
  "description": "Documentation schema; the source validator enforces freeze consistency before HTTP. UNSELECTED is a non-runnable template, not a baseline.",
  "type": "object",
  "required": ["kind", "selection", "identity", "hardware", "profile", "model", "settings", "workload", "workloadSha256", "concurrency", "repetitions", "requestsPerRound", "limits", "tokenBudgets", "startupDefinitions", "observer", "peerJournal", "thresholds", "reliability"],
  "properties": {
    "kind": {"const": "uar.runtime-measurement/v1"},
    "selection": {
      "type": "object",
      "required": ["status", "ownerDecision", "experimentId", "externalSpendAllowed", "syntheticProviderOnly", "comparison", "rigDisposition"],
      "properties": {
        "status": {"enum": ["selected", "unselected"]},
        "ownerDecision": {"type": ["string", "null"]},
        "experimentId": {"type": ["string", "null"]},
        "externalSpendAllowed": {"const": false},
        "syntheticProviderOnly": {"const": true},
        "comparison": {"const": "NONE"},
        "rigDisposition": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"selection": {"properties": {"status": {"const": "selected"}}}}},
    "then": {
      "properties": {
        "identity": {
          "type": "object",
          "required": ["sourceCommit", "sourceInventoryDigest", "imageDigest", "configDigest", "settingsDigest", "platform"],
          "properties": {
            "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "imageDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "sourceInventoryDigest": {"$ref": "#/$defs/hash"},
            "configDigest": {"$ref": "#/$defs/hash"},
            "settingsDigest": {"$ref": "#/$defs/hash"},
            "platform": {"const": "linux/amd64"}
          }
        },
        "hardware": {"type": "object", "required": ["description", "cpuModel", "allocatedCpuCount", "memoryLimitBytes", "kernel", "os", "containerRuntime"]},
        "profile": {"type": "object", "required": ["bundle", "persistence", "gateway", "durabilityDisclosure", "egressPolicy"]},
        "model": {"type": "object", "required": ["selector", "providerModelId", "agentId", "agentArtifactSha256", "providerSettingsSha256", "providerRevision", "modelRevision"]},
        "settings": {"type": "object", "required": ["memoryEnabled", "streamMode", "promptCachingEnabled", "temperature", "tools", "retryDisclosure"]},
        "workload": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "required": ["id", "synthetic", "messages", "expectedText", "providerDelayMs", "responseChunks", "reportedUsage"],
            "properties": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"}, "synthetic": {"const": true},
              "messages": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["role", "content"], "properties": {"role": {"const": "user"}, "content": {"type": "string", "minLength": 1}}}},
              "expectedText": {"type": "string", "minLength": 1}, "providerDelayMs": {"type": "number", "minimum": 0},
              "responseChunks": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["text", "delayMs"]}},
              "reportedUsage": {"type": "object", "required": ["prompt_tokens", "completion_tokens", "total_tokens"]}
            }
          }
        },
        "workloadSha256": {"$ref": "#/$defs/hash"},
        "concurrency": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/positiveInteger"}},
        "repetitions": {"$ref": "#/$defs/positiveInteger"},
        "requestsPerRound": {"$ref": "#/$defs/positiveInteger"},
        "limits": {"type": "object", "required": ["maxRequests", "maxExperimentMs", "frameworkTimeoutMs", "requestTimeoutMs", "maxRequestBytes", "maxResponseBytes", "maxJournalBytes", "observationWaitMs", "pollIntervalMs", "maxPeerRequests"]},
        "tokenBudgets": {"type": "object", "required": ["input", "output", "reasoning", "inputEvidenceLimit"]},
        "startupDefinitions": {"type": "object", "required": ["cold", "warm"]},
        "observer": {"type": "object", "required": ["sourceRevision", "clockDefinition", "maxClockSkewMs", "maxSampleGapMs", "journalPath"]},
        "peerJournal": {"type": "string", "minLength": 1},
        "thresholds": {"type": "object", "required": ["firstResponseP50Ms", "firstResponseP95Ms", "firstResponseP99Ms", "completeP50Ms", "completeP95Ms", "completeP99Ms", "throughputPerSecond", "errorRate", "cancelRate", "coldStartupMs", "warmStartupMs", "cpuCoresUsed", "rssPeakBytes", "runtimeQueuePeak", "runtimeBackpressureDelta"], "additionalProperties": {"$ref": "#/$defs/threshold"}},
        "reliability": {"type": "object", "required": ["cancellation", "toolLoop", "longConversation", "interruptedStream", "backendOutageRecovery", "controlledRestart"], "additionalProperties": {"$ref": "#/$defs/reliability"}}
      }
    }
  }],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "threshold": {"oneOf": [
      {"type": "object", "required": ["decision", "operator", "value"], "properties": {"decision": {"const": "selected"}, "operator": {"enum": ["lte", "gte"]}, "value": {"type": "number", "minimum": 0}}},
      {"type": "object", "required": ["decision", "reason"], "properties": {"decision": {"const": "unselected"}, "reason": {"type": "string", "minLength": 1}}}
    ]},
    "reliability": {"type": "object", "required": ["decision", "sourceCase"], "properties": {"decision": {"enum": ["selected", "unselected"]}, "sourceCase": {"type": "string"}, "reason": {"type": "string"}, "receiptPath": {"type": "string"}, "sha256": {"$ref": "#/$defs/hash"}, "sourceCaseSha256": {"$ref": "#/$defs/hash"}}}
  }
}
