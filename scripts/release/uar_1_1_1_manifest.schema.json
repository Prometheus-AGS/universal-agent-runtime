{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAR 1.1.1 phase integration manifest",
  "type": "object",
  "required": [
    "schema_version",
    "phase",
    "version",
    "stage",
    "source_commit",
    "source_tree",
    "fixture_tree",
    "image",
    "platform",
    "groups",
    "resource_root",
    "evidence_root",
    "infrastructure_file",
    "implementation_inventory"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "phase": {
      "const": "uar-outstanding-issues-v1-1-1"
    },
    "version": {
      "const": "1.1.1"
    },
    "stage": {
      "enum": [
        "local",
        "published"
      ]
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_tree": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fixture_tree": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "linux/arm64",
        "linux/amd64"
      ]
    },
    "index_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "binding",
          "streams",
          "mcp-outcomes",
          "credentials",
          "recovery",
          "combined"
        ]
      }
    },
    "resource_root": {
      "type": "string",
      "pattern": "^/"
    },
    "evidence_root": {
      "type": "string",
      "pattern": "^/"
    },
    "infrastructure_file": {
      "type": "string",
      "pattern": "^/"
    },
    "implementation_inventory": {
      "type": "object",
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "publication_receipt": {
      "type": "object",
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "repair_parent": {
      "type": "object",
      "required": [
        "path",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        }
      }
    },
    "repair_source_change": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "published"}}},
      "then": {"required": ["index_digest", "publication_receipt"]}
    }
  ]
}
