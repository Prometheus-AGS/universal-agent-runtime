  "oracles": {
    "nativeEcho": "Measured native effect is successful canonical main tool outcome with name native_echo and output echoed.message matching the fixture marker. Peer tool_intents is an attempt, not an effect; no peer endpoint measures native execution.",
    "budgetError": "Exactly one budget_admission_failed error envelope followed by one [DONE], no success/finish_reason stop frame; exact category remains frozen even if current implementation emits a generic code (that is FAIL, not relaxed oracle).",
    "providerFailure": "Peer returns503 fixture_provider_failure. It must not be relabeled budget_admission_failed; retain truthful terminal behavior instead of treating any error as budget proof.",
    "disconnect": "Peer emits one content frame then closes a deliberately short Content-Length body with no terminal/[DONE]; main must preserve incomplete/provider/disconnect distinction, no fabricated success.",
    "child": "spawn_agent arguments are source-backed. Optional wait_tool waits at most1000ms exactly once after parsing actual child thread_id. Spawn ack/parent DONE is not child completion. Require actual wait result/run terminal outcome and /cases/child-negative/model_requests==0 for child token0 refusal; a wait timeout is BLOCKED, never success. Do not retry into additional loops.",
    "counters": "GET /__uar_fixture/status: counts/model_requests and embedding request/input/response counts; cases/<configured-case>/model_requests and tool_intents always present including0. Actual native tool/child effects require main canonical receipts; no MCP fixture is introduced.",
    "count": "Standalone main COUNT-01 remains BLOCKED/unsupported without an existing trusted host preparation. No seam added by this fixture."
  },
  "heldEmbeddings": {
    "arm": {
      "target": "peer",
      "method": "POST",
      "path": "/__uar_fixture/control",
      "json": {
        "action": "arm_embeddings",
        "group": "{uniqueHoldGroup}",
        "expected": 2
      }
    },
    "inputMarker": "UAR_HOLD:{uniqueHoldGroup}: plus unique document/query identity terms",
    "status": {
      "target": "peer",
      "method": "GET",
      "path": "/__uar_fixture/status",
      "assertPointers": {
        "/held/{uniqueHoldGroup}/arrived": 2,
        "/held/{uniqueHoldGroup}/released": false,
        "/held/{uniqueHoldGroup}/expired": 0
      }
    },
    "release": {
      "target": "peer",
      "method": "POST",
      "path": "/__uar_fixture/control",
      "json": {
        "action": "release_embeddings",
        "group": "{uniqueHoldGroup}"
      },
      "assertPointer": "/released",
      "equals": "{uniqueHoldGroup}"
    },
    "assertionLimit": "This proves overlapping held embedding request windows, not a forced SurrealDB transaction race. Both uploads must have positive retrieval sentinels; retain typed failures. Arm must precede uploads, release before20seconds; expiry returns504 and never counts as successful ingestion. Multiple chunk batches may make arrived>2; choose owned single-chunk inputs under existing chunk config and inspect actual count, never relabel surplus arrivals.",
    "embedding": "Deterministic normalized hashed-word vectors of the explicitly supplied existing dimension; not a semantic quality benchmark or compatible replacement for any persisted embedding fingerprint."
  }
