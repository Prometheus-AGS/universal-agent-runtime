<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.prometheus.uar-supervisor</string>
<key>ProgramArguments</key><array>
<string>/usr/local/bin/python3</string><string>/usr/local/libexec/uar-supervisor/controller.py</string>
<string>--config</string><string>/Library/Application Support/UAR-Supervisor/controller.json</string>
</array>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>Umask</key><integer>63</integer>
<key>ProcessType</key><string>Background</string>
</dict></plist>
