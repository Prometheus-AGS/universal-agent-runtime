n\":\"1.0.0\"},\"title\":\"Researcher\",\"version\":\"1.0.0\",\"whenToUse\":\"Find and state the facts a request needs.\"}",
        "team.json": "{\"budget\":{\"currency\":\"USD\",\"maxCostMicrounits\":3000000,\"maxElapsedSeconds\":360,\"maxTokens\":384000},\"communication\":[{\"fromRole\":\"researcher\",\"modes\":[\"queue-only\",\"trigger-turn\"],\"toRole\":\"writer\"},{\"fromRole\":\"writer\",\"modes\":[\"queue-only\",\"trigger-turn\"],\"toRole\":\"researcher\"}],\"contentDigest\":\"sha256:5393d5b8a82cbd481e0c3b11c1b2e6cd7ac8cbba66eff37365190f1e732aae15\",\"coordinatorRole\":\"writer\",\"extensions\":{},\"id\":\"urn:uar:console-sample:team\",\"input\":{},\"instructions\":{\"digest\":\"sha256:dbddd6698be847e347288eb28e0d85cfa0d2cd202a5fc630bac9090aa696810b\",\"revision\":1,\"text\":\"Complete the assigned taskInput.request directly. Do not reveal planning or reasoning.\"},\"kind\":\"TeamDefinition\",\"limits\":{\"concurrentTurns\":2,\"maxDepth\":1,\"maxMembers\":2,\"maxPendingTasks\":8},\"members\":[{\"definition\":{\"digest\":\"sha256:41a99cc8465b7fce4ba9ef7aa090e45bb402476eb26762aaa0cb3c54026683fe\",\"id\":\"urn:uar:console-sample:agent:researcher\",\"version\":\"1.0.0\"},\"kind\":\"agent\",\"max\":1,\"min\":1,\"responsibility\":\"Gather facts\",\"role\":\"researcher\"},{\"definition\":{\"digest\":\"sha256:e8c43571213669ece02b772763e03411b534d66b83d8a6787342a6cbd7677000\",\"id\":\"urn:uar:console-sample:agent:writer\",\"version\":\"1.0.0\"},\"kind\":\"agent\",\"max\":1,\"min\":1,\"responsibility\":\"Write and coordinate\",\"role\":\"writer\"}],\"output\":{},\"profile\":\"urn:prometheus:uar:collaboration:0.1.0-draft.2\",\"provenance\":{\"authors\":[\"UAR operator\"],\"source\":\"Sample team for the operator console\"},\"purpose\":\"A two-member sample team for exercising the operator console\",\"requiredCapabilities\":[],\"routing\":{\"eligibilityFirst\":true,\"explain\":true,\"strategy\":\"operator-role-capacity-cost-stable-id\"},\"taskAcceptance\":{\"allowedWorkflows\":[],\"mode\":\"coordinator-within-binding\"},\"title\":\"Research and writing team\",\"version\":\"1.0.0\"}",
